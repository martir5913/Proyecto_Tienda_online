{
  "info": {
    "name": "domestik API - RF19",
    "description": "Colección para consultar y probar las APIs internas del proyecto ElectroHogar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Público",
      "item": [
        {
          "name": "Productos - Listar",
          "request": {"method": "GET", "header": [{"key":"Accept","value":"application/json"}], "url": "{{base_url}}/api/productos.php"}
        },
        {
          "name": "Productos - Buscar",
          "request": {"method": "GET", "header": [{"key":"Accept","value":"application/json"}], "url": "{{base_url}}/api/productos.php?q=samsung"}
        },
        {
          "name": "Productos - Detalle",
          "request": {"method": "GET", "header": [{"key":"Accept","value":"application/json"}], "url": "{{base_url}}/api/productos.php?id={{product_id}}"}
        },
        {
          "name": "Categorías",
          "request": {"method": "GET", "header": [{"key":"Accept","value":"application/json"}], "url": "{{base_url}}/api/categorias.php"}
        },
        {
          "name": "Marcas",
          "request": {"method": "GET", "header": [{"key":"Accept","value":"application/json"}], "url": "{{base_url}}/api/marcas.php"}
        }
      ]
    },
    {
      "name": "02 - Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"correo\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"},
            "url": "{{base_url}}/api/auth.php?action=login"
          }
        },
        {
          "name": "Comprobar sesión",
          "request": {"method": "GET", "header": [{"key":"Accept","value":"application/json"}], "url": "{{base_url}}/api/auth.php?action=check"}
        },
        {
          "name": "Logout",
          "request": {"method": "POST", "header": [{"key":"Accept","value":"application/json"}], "url": "{{base_url}}/api/auth.php?action=logout"}
        }
      ]
    },
    {
      "name": "03 - Carrito y Wishlist",
      "item": [
        {
          "name": "Carrito - Obtener",
          "request": {"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/carrito.php?action=get"}
        },
        {
          "name": "Carrito - Agregar",
          "request": {"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"id_producto\": {{product_id}},\n  \"cantidad\": 1\n}"},"url":"{{base_url}}/api/carrito.php?action=add"}
        },
        {
          "name": "Wishlist - Obtener",
          "request": {"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/wishlist.php?action=get"}
        },
        {
          "name": "Wishlist - Agregar",
          "request": {"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"id_producto\": {{product_id}}\n}"},"url":"{{base_url}}/api/wishlist.php?action=add"}
        }
      ]
    },
    {
      "name": "04 - Pedidos",
      "item": [
        {
          "name": "Historial",
          "request": {"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/pedidos.php?action=historial"}
        },
        {
          "name": "Checkout (requiere csrf_checkout)",
          "request": {"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"csrf_token\": \"{{csrf_checkout}}\",\n  \"id_metodo_pago\": {{payment_method_id}},\n  \"direccion_envio\": \"Dirección de prueba\",\n  \"notas\": \"Prueba desde Postman\"\n}"},"url":"{{base_url}}/api/pedidos.php?action=checkout"}
        }
      ]
    },
    {
      "name": "05 - Administración",
      "item": [
        {
          "name": "Diagnóstico DB",
          "request": {"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/test_db.php"}
        },
        {
          "name": "Pedidos admin - Listar (si está instalado)",
          "request": {"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/admin_pedidos.php?action=listar"}
        },
        {
          "name": "Pedidos admin - Detalle (si está instalado)",
          "request": {"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/admin_pedidos.php?action=detalle&id={{order_id}}"}
        },
        {
          "name": "Pedidos admin - Cambiar estado (requiere CSRF)",
          "request": {"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-Token","value":"{{csrf_admin_pedidos}}"}],"body":{"mode":"raw","raw":"{\n  \"id_pedido\": {{order_id}},\n  \"id_estado_pedido\": 2\n}"},"url":"{{base_url}}/api/admin_pedidos.php?action=cambiar_estado"}
        }
      ]
    }
  ]
}
