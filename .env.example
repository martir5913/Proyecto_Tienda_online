# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Instrucciones: Copie este archivo como '.env' y configure sus credenciales locales.

# Entorno de aplicacion
APP_ENV=development
APP_NAME="ElectroHogar - Tienda en Línea"
APP_URL="http://localhost:8000/Proyecto_Tienda_online"

# Configuracion de Base de Datos MySQL
# Ajuste segun su entorno local (Docker o XAMPP nativo):
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=tienda_electrodomesticos
DB_USER=root
DB_PASS=su_contraseña_aqui
DB_CHARSET=utf8mb4

# Clave secreta
APP_SECRET="cambiar_por_clave_secreta_local"
